{
  "ci": {
    "collect": {
      "numberOfRuns": 3,
      "startServerCommand": "pnpm preview",
      "startServerReadyPattern": "Ready on",
      "startServerReadyTimeout": 180000,
      "url": [
        "http://localhost:8787/",
        "http://localhost:8787/summit",
        "http://localhost:8787/founders-after-hours"
      ]
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": ".*/(summit)?$",
          "preset": "lighthouse:recommended",
          "assertions": {
            "categories:performance": ["error", { "minScore": 0.7, "aggregationMethod": "median-run" }],
            "categories:accessibility": ["error", { "minScore": 1 }],
            "largest-contentful-paint": ["error", { "maxNumericValue": 3000, "aggregationMethod": "median-run" }],
            "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }],
            "total-blocking-time": ["error", { "maxNumericValue": 1200, "aggregationMethod": "median-run" }],
            "resource-summary:script:size": ["error", { "maxNumericValue": 440000 }],
            "resource-summary:third-party:size": ["error", { "maxNumericValue": 200000 }],
            "resource-summary:third-party:count": ["error", { "maxNumericValue": 8 }],
            "resource-summary:image:size": ["error", { "maxNumericValue": 250000 }],
            "resource-summary:media:size": ["error", { "maxNumericValue": 0 }],
            "resource-summary:total:size": ["error", { "maxNumericValue": 660000 }],
            "resource-summary:font:size": ["error", { "maxNumericValue": 120000 }],
            "server-response-time": ["warn", { "maxNumericValue": 600, "aggregationMethod": "median-run" }],
            "bf-cache": "off",
            "uses-long-cache-ttl": "off",
            "unused-javascript": "off",
            "legacy-javascript": "off",
            "third-party-summary": "off",
            "bootup-time": "off",
            "mainthread-work-breakdown": "off",
            "max-potential-fid": "off"
          }
        },
        {
          "matchingUrlPattern": ".*founders-after-hours$",
          "preset": "lighthouse:recommended",
          "assertions": {
            "categories:performance": ["error", { "minScore": 0.7, "aggregationMethod": "median-run" }],
            "categories:accessibility": ["error", { "minScore": 1 }],
            "largest-contentful-paint": ["error", { "maxNumericValue": 3000, "aggregationMethod": "median-run" }],
            "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }],
            "total-blocking-time": ["error", { "maxNumericValue": 1200, "aggregationMethod": "median-run" }],
            "resource-summary:script:size": ["error", { "maxNumericValue": 450000 }],
            "resource-summary:third-party:size": ["error", { "maxNumericValue": 200000 }],
            "resource-summary:third-party:count": ["error", { "maxNumericValue": 8 }],
            "resource-summary:image:size": ["error", { "maxNumericValue": 250000 }],
            "resource-summary:media:size": ["error", { "maxNumericValue": 0 }],
            "resource-summary:total:size": ["error", { "maxNumericValue": 700000 }],
            "resource-summary:font:size": ["error", { "maxNumericValue": 120000 }],
            "server-response-time": ["warn", { "maxNumericValue": 600, "aggregationMethod": "median-run" }],
            "bf-cache": "off",
            "uses-long-cache-ttl": "off",
            "unused-javascript": "off",
            "legacy-javascript": "off",
            "third-party-summary": "off",
            "bootup-time": "off",
            "mainthread-work-breakdown": "off",
            "max-potential-fid": "off"
          }
        }
      ]
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
